# Local development values. Copy to .env.development. Test and production use AWS Secrets Manager.
APP_ENV=development
# Application login: owns nothing, cannot bypass RLS.
DATABASE_URL=postgres://cv_app:cv_app@localhost:5433/campusverse
# Migration login: owns the schema. Only db:migrate uses it.
MIGRATION_DATABASE_URL=postgres://cv_migrator:cv_migrator@localhost:5433/campusverse
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Development only, to try the phone app over Wi-Fi: API_HOST=0.0.0.0
# Local-only value. Real environments generate 32+ random bytes into Secrets Manager.
AUTH_PEPPER=local-development-pepper-not-a-secret-000
# Local-only key. Real environments keep field keys in Secrets Manager.
FIELD_KEYS=1:GfRl/JyNJ7Nmv8XoySKQyNAWe0qtEDb/FfvoL/eO9Us=
# The health vault's own keys, same format. Unset: derived from FIELD_KEYS (set its own in test and live).
# HEALTH_KEYS=
# GOOGLE_CLIENT_ID=
S3_BUCKET=campusverse-dev
S3_ENDPOINT=http://localhost:9090
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
# Super admin app; staff passkeys are bound to its host name. Optional locally (this is the default).
ADMIN_ORIGIN=http://localhost:3001
# Verse AI. Without a key, development answers with an offline stand-in model (nothing is sent).
# A real key sends questions and tool results (operational data only) to the Anthropic API.
# ANTHROPIC_API_KEY=
# VERSE_MODEL=claude-opus-5-5
# Or OpenAI (decision 0020). With both keys, VERSE_PROVIDER=claude|openai chooses.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# VERSE_PROVIDER=openai
# Your own test phone numbers. Nothing else receives WhatsApp or SMS outside production.
MESSAGE_ALLOWLIST=

# Razorpay online payments: all three or none (development uses a fake gateway without them).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# PAYMENT_RETURN_URL=https://...
