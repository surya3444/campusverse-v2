{
  "name": "campusverse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:infra": "docker compose up -d --wait",
    "dev:infra:down": "docker compose down",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit",
    "boundaries": "depcruise . --config .dependency-cruiser.cjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries",
    "test:rls": "vitest run --project integration packages/db/tests",
    "db:migrate": "pnpm --filter @campusverse/db migrate",
    "db:seed": "pnpm --filter @campusverse/db seed",
    "dev:infra:reset": "docker compose down -v && docker compose up -d --wait",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @campusverse/web test:e2e",
    "db:restore-rehearsal": "scripts/restore-rehearsal.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
