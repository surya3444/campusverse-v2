{
  "name": "@campusverse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=../../.env.development --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env.development --import tsx scripts/seed.ts",
    "restore-check": "node --env-file-if-exists=../../.env.development --import tsx scripts/restore-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@campusverse/config": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "postgres": "^4.0.0"
  }
}
